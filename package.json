{
  "name": "portfolio-fabiano",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs && node scripts/check-budgets.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "contrast": "node scripts/contrast.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "serve": "node scripts/serve.mjs",
    "test": "playwright test --project=chromium --project=firefox --project=webkit --project=form --project=form-limit --project=unit",
    "test:visual": "playwright test --project=visual",
    "test:all": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.5",
    "@astrojs/vercel": "11.0.22",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "astro": "7.4.12",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@iconify-json/devicon-plain": "1.2.74",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "simple-icons": "16.38.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "basic-ftp": "6.2.6"
  }
}
