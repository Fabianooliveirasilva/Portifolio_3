# Server-only. Never prefix with PUBLIC_. Copy to .env and fill in.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Extra allowed Origins for the form, comma separated (custom domain)
SITE_ORIGINS=
# true = validate and rate limit but do not send (local and E2E tests)
CONTACT_DRY_RUN=false
# Memory limiter only (CONTACT_DRY_RUN=true): max requests per IP per 10 min. Default 5.
CONTACT_RATE_LIMIT=
# Public WhatsApp button: digits only with country code (e.g. 34600000000). Empty = no button.
# It ends up in the page's HTML, so use a number you are fine making public.
WHATSAPP_NUMBER=
