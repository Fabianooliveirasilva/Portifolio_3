---
import Section from './Section.astro';
import TechTag from './TechTag.astro';

interface Props {
  title: string;
  groups: { label: string; items: string[] }[];
}
const { title, groups } = Astro.props;
---

<Section small id="skills" title={title} class="skills">
  <dl>
    {groups.map((g) => (
      <>
        <dt>{g.label}</dt>
        <dd>
          <ul>
            {g.items.map((i) => (
              <TechTag name={i} />
            ))}
          </ul>
        </dd>
      </>
    ))}
  </dl>
</Section>

<style>
  .skills {
    gap: var(--space-5);
  }
  dl {
    margin: 0;
    display: grid;
    gap: var(--space-1) var(--space-6);
  }
  dt {
    font-family: var(--font-display);
    font-weight: 600;
    margin-block-start: var(--space-3);
  }
  dd {
    margin: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  @media (min-width: 48rem) {
    dl {
      row-gap: var(--space-5);
      grid-template-columns: 10rem 1fr;
    }
    dt {
      margin: 0;
    }
  }
</style>
