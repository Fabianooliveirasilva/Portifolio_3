---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import ProjectFeature from './ProjectFeature.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  intro?: string | undefined;
  labels: { viewCode: string; didLabel: string; stackLabel: string };
}
const { lang, title, intro, labels } = Astro.props;
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section id="work" title={title} intro={intro} class="work">
  <div class="grid">
    {projects.map((project, i) => (
      <ProjectFeature {project} {lang} index={i} {labels} />
    ))}
  </div>
</Section>

<style>
  .grid {
    display: grid;
    gap: var(--space-9);
  }
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-6);
      row-gap: var(--space-10);
    }
    .grid > :global(.wide),
    .grid > :global(.wide-flip) {
      grid-column: 1 / -1;
    }
    .grid > :global(.left) {
      grid-column: 1 / 8;
    }
    .grid > :global(.right) {
      grid-column: 8 / -1;
      margin-block-start: var(--space-9);
    }
  }
</style>
