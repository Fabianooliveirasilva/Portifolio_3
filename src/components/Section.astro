---
interface Props {
  id: string;
  title: string;
  intro?: string | undefined;
  class?: string;
  small?: boolean;
  rail?: boolean;
}
const {
  id,
  title,
  intro,
  class: cls = '',
  small = false,
  rail = false,
} = Astro.props;
---

<section
  {id}
  class:list={['section', cls, { rail }]}
  aria-labelledby={`${id}-title`}
>
  <header>
    <h2 id={`${id}-title`} class:list={{ small }}>
      {title}
    </h2>
    {intro && <p class="intro">{intro}</p>}
  </header>
  <slot />
</section>

<style>
  .section {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 64rem) {
    .rail {
      grid-template-columns: 13rem minmax(0, 1fr);
      column-gap: var(--space-6);
      align-items: start;
    }
  }
  h2.small {
    font-size: var(--step-2);
  }
  .intro {
    margin-block-start: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink-muted);
  }
</style>
