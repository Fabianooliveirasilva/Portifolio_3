---
import '../styles/tokens.css';
import '../styles/base.css';
import {
  languages,
  langs,
  htmlLang,
  ogLocale,
  ui,
  path,
  type Lang,
} from '../i18n/ui';
import { personJsonLd } from '../lib/jsonld';
import WhatsApp from '../components/WhatsApp.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
}
const { lang, title, description, noindex = false } = Astro.props;
const t = ui[lang];
const site = Astro.site!;
const url = (l: Lang) => new URL(path(l), site).href;
const ogImage = new URL('/og.png', site).href;
const sections = [
  'education',
  'skills',
  'work',
  'qa',
  'path',
  'contact',
] as const;
const home = path(lang);
---

<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#2b0a16" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!noindex && (
      <>
        <link rel="canonical" href={url(lang)} />
        {langs.map((l) => (
          <link rel="alternate" hreflang={htmlLang[l]} href={url(l)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={url('pt-br')} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={url(lang)} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content={ogLocale[lang]} />
        {langs
          .filter((l) => l !== lang)
          .map((l) => (
            <meta property="og:locale:alternate" content={ogLocale[l]} />
          ))}
        <meta name="twitter:card" content="summary_large_image" />
        <script
          type="application/ld+json"
          set:html={personJsonLd(lang, site.href, description)}
        />
      </>
    )}
    <link
      rel="preload"
      href="/fonts/texturina-name.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/bricolage.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <div class="shell">
      <header class="site-header">
        <a class="site-name" href={home}>
          Fabiano Oliveira Silva
        </a>
        <nav class="sections" aria-label={t.sections}>
          <ul>
            {sections.map((s) => (
              <li>
                <a href={`${home}#${s}`}>{t.nav[s]}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav class="langs" aria-label={t.language}>
          <ul>
            {langs.map((l) => (
              <li>
                <a
                  href={path(l)}
                  hreflang={htmlLang[l]}
                  lang={htmlLang[l]}
                  aria-current={l === lang ? 'true' : undefined}
                >
                  {languages[l]}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
    </div>
    <WhatsApp {lang} />
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-3) var(--space-5);
    align-items: baseline;
    padding: var(--space-5) var(--gutter) 0;
  }
  .site-name {
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }
  .sections {
    grid-column: 1 / -1;
    grid-row: 2;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  nav a {
    display: inline-block;
    min-height: 24px;
    padding-block: var(--space-1);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step--1);
    text-decoration: none;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
  }
  nav a:hover,
  nav a:focus-visible {
    color: var(--ink);
  }
  .sections a {
    position: relative;
  }
  .sections a::before {
    content: '';
    position: absolute;
    inset-inline-start: calc(var(--space-6) * -1);
    inset-block-start: 50%;
    width: 1.25rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s;
  }
  .sections a:hover::before,
  .sections a:focus-visible::before {
    transform: scaleX(1);
  }
  nav a[aria-current='true'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 0.16em;
  }
  main {
    padding: var(--space-7) var(--gutter) var(--space-9);
  }
  @media (min-width: 64rem) {
    .shell {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
    .site-header {
      position: sticky;
      top: 0;
      align-self: start;
      height: 100dvh;
      grid-template-columns: 1fr;
      grid-auto-rows: min-content;
      align-content: start;
      gap: var(--space-6);
      padding: var(--space-6) 0 var(--space-6) var(--gutter);
      background: var(--glass-bg);
      border-inline-end: 1px solid var(--glass-edge);
      box-shadow: var(--glass-shadow);
      backdrop-filter: var(--glass-blur);
    }
    .sections {
      grid-row: auto;
    }
    .sections ul {
      flex-direction: column;
      gap: var(--space-2);
    }
    .langs {
      margin-block-start: auto;
    }
    .site-header {
      grid-template-rows: auto auto 1fr;
    }
    nav a {
      font-size: var(--step-0);
    }
    main {
      padding-inline: var(--space-8) var(--gutter);
    }
  }
</style>
